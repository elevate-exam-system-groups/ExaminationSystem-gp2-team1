# ============================================================
# ExaminationSystem — Production .gitignore
# Clean Architecture | .NET 10 | Visual Studio 2022
# ============================================================

# ------------------------------------------------------------
# [1] BUILD OUTPUTS — Never commit compiled artifacts
# ------------------------------------------------------------
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
bld/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
artifacts/
out/

# ------------------------------------------------------------
# [2] VISUAL STUDIO — IDE-specific files (never shared)
# ------------------------------------------------------------
.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
Generated\ Files/
.vshistory/
.localhistory/

# ------------------------------------------------------------
# [3] NUGET PACKAGES — Restored at build time, never tracked
# ------------------------------------------------------------
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
nuget.config.user

# ------------------------------------------------------------
# [4] TEST RESULTS — Generated by test runners
# ------------------------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResult.xml
nunit-*.xml
*.VisualState.xml
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
BenchmarkDotNet.Artifacts/
OpenCover/

# ------------------------------------------------------------
# [5] SECRETS & ENVIRONMENT — CRITICAL: Never commit secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
appsettings.Production.json
appsettings.Staging.json
secrets.json
**/secrets.json

# ------------------------------------------------------------
# [6] COMPILED FILES — Binary objects never belong in git
# ------------------------------------------------------------
*_i.c
*_p.c
*_h.h
*.ilk
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.pidb
*.svclog
*.rsp

# ------------------------------------------------------------
# [7] RESHARPER / RIDER — JetBrains IDE files
# ------------------------------------------------------------
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/
*.sln.iml

# ------------------------------------------------------------
# [8] SQL SERVER — Local database files
# ------------------------------------------------------------
*.mdf
*.ldf
*.ndf

# ------------------------------------------------------------
# [9] DOCKER — Local overrides only
# ------------------------------------------------------------
docker-compose.override.yml
.dockerignore.local

# ------------------------------------------------------------
# [10] NODE / FRONTEND — If any frontend project exists
# ------------------------------------------------------------
node_modules/
dist/
.npm/
*.code-workspace

# ------------------------------------------------------------
# [11] OS FILES — Windows/macOS clutter
# ------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# ------------------------------------------------------------
# [12] MISC BUILD & CI TOOLS
# ------------------------------------------------------------
*.binlog
*.cache
!?*.[Cc]ache/
FakesAssemblies/
MigrationBackup/
ScaffoldingReadMe.txt
.fake/
.paket/paket.exe
paket-files/
FodyWeavers.xsd
mono_crash.*
healthchecksdb

# Azure
csx/
*.build.csdef
ecf/
rcf/
PublishScripts/
*.azurePubxml
*.pubxml
*.publishproj
*.publishsettings

# Windows Installer
*.cab
*.msi
*.msix
*.msm

# NCrunch / Code Coverage
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*
*.dotCover
.axoCover/*
!.axoCover/settings.json

# Profiler
*.psess
*.vsp
*.vspx
*.sap
*.e2e

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Build output
bin/
obj/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
*.snupkg
packages/
*.lock.json

# Runtime & logs
*.log
*.cache

# OS files
.DS_Store
Thumbs.db

# User-specific
launchSettings.json
appsettings.Development.json
/ExaminationSystem/ExaminationSystem.Infrastructure/NewFolder/FileName.cs
